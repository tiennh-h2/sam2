@@ -0,0 +1,115 @@
+"""Dump EntityQueryModel predictions on overlapping image slices."""
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+from PIL import Image
+from torch.nn import functional as F
+
+from sam2.modeling.entity_query import EntityQueryModel
+from training.entity_query_images import encode_image
+
+
+def tile_boxes(width, height, size=1024, overlap=256):
+    if size <= 0 or not 0 <= overlap < size:
+        raise ValueError("Expected size > 0 and 0 <= overlap < size")
+
+    def positions(length):
+        if length <= size:
+            return [0]
+        starts = list(range(0, length - size + 1, size - overlap))
+        if starts[-1] != length - size:
+            starts.append(length - size)
+        return starts
+
+    for y in positions(height):
+        for x in positions(width):
+            yield x, y, min(x + size, width), min(y + size, height)
+
+
+def render_overlay(tile, instances):
+    rgb = np.asarray(tile.convert("RGB")).copy()
+    overlay = rgb.copy()
+    colors = np.random.default_rng(3).integers(50, 256, (max(1, len(instances)), 3), dtype=np.uint8)
+    for i, item in enumerate(instances):
+        mask = item["mask"]
+        overlay[mask] = colors[i]
+    return Image.fromarray((0.55 * rgb + 0.45 * overlay).astype(np.uint8))
+
+
+@torch.inference_mode()
+def predict_tile(model, tile, device, score_threshold, min_area):
+    image_size = model.sam_model.image_size
+    image = encode_image(tile, image_size).unsqueeze(0).to(device)
+    outputs = model(image)
+    indices = torch.nonzero(outputs["pred_logits"][0].sigmoid() >= score_threshold).flatten()
+    if not indices.numel():
+        return []
+    logits = F.interpolate(outputs["pred_masks"][0, indices, None].float(),
+                           size=(tile.height, tile.width), mode="bilinear", align_corners=False)[:, 0]
+    masks = logits > 0
+    scores = outputs["pred_logits"][0, indices].sigmoid()
+    instances = []
+    for index, score, mask in zip(indices.tolist(), scores.tolist(), masks.cpu().numpy()):
+        if int(mask.sum()) >= min_area:
+            instances.append({"query": index, "score": score, "mask": mask})
+    return sorted(instances, key=lambda item: -item["score"])
+
+
+def run(args):
+    from sam2.build_sam import build_sam2
+
+    checkpoint = torch.load(args.query_checkpoint, map_location="cpu", weights_only=False)
+    cfg = args.model_cfg or checkpoint["model_cfg"]
+    sam_checkpoint = args.sam_checkpoint or checkpoint["sam_checkpoint"]
+    sam_model = build_sam2(cfg, sam_checkpoint, device=args.device, apply_postprocessing=False)
+    if checkpoint.get("sam_backbone") is not None:
+        sam_model.load_state_dict(checkpoint["sam_backbone"], strict=True)
+    model = EntityQueryModel(sam_model, checkpoint["num_queries"]).to(args.device)
+    if model.sam_model.image_size != checkpoint["image_size"]:
+        raise ValueError("SAM 2 model image_size differs from the trained query checkpoint")
+    model.query_head.load_state_dict(checkpoint["query_head"], strict=True)
+    model.eval()
+    args.out_dir.mkdir(parents=True, exist_ok=True)
+    paths = sorted(p for p in args.img_dir.iterdir() if p.suffix.lower() in {".jpg", ".jpeg", ".png", ".tif", ".tiff"})
+    for path in paths:
+        with Image.open(path) as image_file:
+            image = image_file.convert("RGB")
+        output = args.out_dir / path.stem
+        output.mkdir(parents=True, exist_ok=True)
+        for tile_id, (x0, y0, x1, y1) in enumerate(tile_boxes(*image.size, args.tile_size, args.overlap)):
+            tile = image.crop((x0, y0, x1, y1))
+            instances = predict_tile(model, tile, args.device, args.score_threshold, args.min_area)
+            tile_dir = output / f"tile_{tile_id:04d}"
+            tile_dir.mkdir(exist_ok=True)
+            tile.save(tile_dir / "image.png")
+            render_overlay(tile, instances).save(tile_dir / "overlay.png")
+            metadata = {"source": path.name, "box_xyxy": [x0, y0, x1, y1], "instances": []}
+            for instance_id, item in enumerate(instances):
+                filename = f"mask_{instance_id:03d}.png"
+                Image.fromarray(item["mask"].astype(np.uint8) * 255).save(tile_dir / filename)
+                metadata["instances"].append({"query": item["query"], "score": item["score"], "mask_file": filename})
+            (tile_dir / "predictions.json").write_text(json.dumps(metadata, indent=2))
+        print(f"wrote slices for {path.name}", flush=True)
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--query-checkpoint", required=True, type=Path)
+    parser.add_argument("--model-cfg", help="Override SAM 2 config stored in query checkpoint")
+    parser.add_argument("--sam-checkpoint", type=Path, help="Override pretrained SAM 2 checkpoint path")
+    parser.add_argument("--img-dir", required=True, type=Path)
+    parser.add_argument("--out-dir", required=True, type=Path)
+    parser.add_argument("--tile-size", type=int, default=1024)
+    parser.add_argument("--overlap", type=int, default=256)
+    parser.add_argument("--score-threshold", type=float, default=0.5)
+    parser.add_argument("--min-area", type=int, default=16)
+    parser.add_argument("--device", default="cuda")
