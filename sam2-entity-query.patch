+# Prompt-free entity queries for SAM 2 images
+
+## Purpose
+
+Discover instances of the single foreground class in FBM image slices without points or boxes at inference. Train from COCO polygon instance masks, including valid images with zero instances. Save per-slice predictions for visual inspection.
+
+## Architecture
+
+Load an existing SAM 2 image checkpoint and use its image encoder and feature pyramid. A separate trainable head cross-attends a fixed number of learned queries to the lowest-resolution image features; each query predicts an objectness logit and a mask via a shared pixel projection. This adapts EntitySAM's query-based entity discovery and communication to still images. It deliberately omits temporal association, DINOv2 semantic encoding, and changes to SAM 2's interactive prompt decoder. Freeze the pretrained SAM 2 backbone by default; optional backbone fine-tuning is explicit.
+
+This is a new head initialized randomly. The stock checkpoint cannot directly perform prompt-free inference. Store the new head's weights, query count, SAM 2 config and checkpoint metadata in a separate checkpoint.
+
+## Data and optimization
+
+Read COCO polygon instances for one class. Resize image and mask together to SAM 2's square input, using the SAM 2 image normalization. Exclude zero-area instance masks from matching. Keep an image with no instances: every query learns background. Match queries to target instances per image using Hungarian assignment over soft mask BCE and Dice costs. Train matched masks with BCE and Dice, and all query objectness logits with binary cross entropy (background down-weighted). If there are more instances than queries, fail with a helpful message instead of silently dropping targets.
+
+## Inference
+
+Load the trained head together with the exact SAM 2 config and backbone checkpoint. Split each image into overlapping fixed-size slices; resize each slice to the encoder input, predict instance masks, reject low-objectness or empty masks, and save masks and colored overlays per slice. Record slice coordinates and scores as JSON; do not assume queries have stable identities across slices. Output masks in each slice's original resolution. Full-image identity merging is a separate problem and is outside this first image-only integration.
+
+## Verification
+
+Exercise matching and loss on empty and populated targets, verify foreground/background gradients, and test polygon rasterization and slice coordinates. Compile the Python files; run a training/inference smoke test when PyTorch, its SAM 2 dependencies and a pretrained checkpoint are present.
diff --git a/sam2/modeling/entity_query.py b/sam2/modeling/entity_query.py
new file mode 100644
index 0000000..418f3ff
--- /dev/null
+++ b/sam2/modeling/entity_query.py
@@ -0,0 +1,111 @@
+"""Image-only, prompt-free instance queries on top of SAM 2 image features.
+
+The query head is deliberately independent of SAM 2's interactive mask decoder.
+It must be trained; an unmodified SAM 2 checkpoint does not contain these weights.
+"""
+
+from contextlib import nullcontext
+
+import torch
+from torch import nn
+from torch.nn import functional as F
+
+
+class EntityQueryHead(nn.Module):
+    def __init__(self, num_queries=50, hidden_dim=256, num_heads=8, num_layers=3):
+        super().__init__()
+        self.queries = nn.Embedding(num_queries, hidden_dim)
+        layer = nn.TransformerDecoderLayer(
+            d_model=hidden_dim, nhead=num_heads, dim_feedforward=hidden_dim * 4,
+            dropout=0.1, batch_first=True, activation="gelu",
+        )
+        self.decoder = nn.TransformerDecoder(layer, num_layers=num_layers)
+        self.mask_embed = nn.Sequential(nn.Linear(hidden_dim, hidden_dim), nn.GELU(), nn.Linear(hidden_dim, hidden_dim))
+        self.pixel_embed = nn.Conv2d(hidden_dim, hidden_dim, 1)
+        self.objectness = nn.Linear(hidden_dim, 1)
+
+    def forward(self, image_features, image_pos, pixel_features):
+        batch = image_features.shape[0]
+        memory = (image_features + image_pos).flatten(2).transpose(1, 2)
+        queries = self.queries.weight.unsqueeze(0).expand(batch, -1, -1)
+        states = self.decoder(queries, memory)
+        masks = torch.einsum("bqc,bchw->bqhw", self.mask_embed(states), self.pixel_embed(pixel_features))
+        return {"pred_masks": masks, "pred_logits": self.objectness(states).squeeze(-1)}
+
+
+class EntityQueryModel(nn.Module):
+    def __init__(self, sam_model, num_queries=50, freeze_backbone=True):
+        super().__init__()
+        self.sam_model = sam_model
+        self.freeze_backbone = freeze_backbone
+        hidden_dim = sam_model.image_encoder.neck.d_model
+        self.query_head = EntityQueryHead(num_queries=num_queries, hidden_dim=hidden_dim)
+        if freeze_backbone:
+            for parameter in self.sam_model.parameters():
+                parameter.requires_grad_(False)
+            self.sam_model.eval()
+
+    def train(self, mode=True):
+        super().train(mode)
+        if self.freeze_backbone:
+            self.sam_model.eval()
+        return self
+
+    def forward(self, images):
+        context = torch.no_grad() if self.freeze_backbone else nullcontext()
+        with context:
+            features = self.sam_model.image_encoder(images)
+        return self.query_head(
+            features["backbone_fpn"][-1],
+            features["vision_pos_enc"][-1],
+            features["backbone_fpn"][0],
+        )
+
+
+def entity_query_loss(outputs, targets, background_weight=0.1):
+    """One-to-one mask matching; targets is a list of N x H x W binary masks."""
+    from scipy.optimize import linear_sum_assignment
+
+    pred_masks, pred_logits = outputs["pred_masks"], outputs["pred_logits"]
+    if pred_masks.ndim != 4 or pred_logits.shape != pred_masks.shape[:2]:
+        raise ValueError("Expected masks [B,Q,H,W] and logits [B,Q]")
+    if len(targets) != pred_masks.shape[0]:
+        raise ValueError("Expected one target tensor per image")
+    objectness_losses, mask_losses, dice_losses = [], [], []
+    for mask_logits, logits, target in zip(pred_masks, pred_logits, targets):
+        if target.ndim != 3:
+            raise ValueError("Each target must be [N,H,W]")
+        target = target.to(device=mask_logits.device, dtype=torch.float32)
+        if target.shape[0]:
+            target = F.interpolate(target[:, None], size=mask_logits.shape[-2:], mode="nearest")[:, 0]
+            target = target[target.flatten(1).any(1)]
+        n, q = target.shape[0], mask_logits.shape[0]
+        if n > q:
+            raise ValueError(f"Image has {n} targets but num_queries={q}; increase num_queries")
+        labels = logits.new_zeros((q,))
+        if n:
+            # Match at lower resolution to avoid Q x N x H x W temporary tensors.
+            size = (min(64, mask_logits.shape[-2]), min(64, mask_logits.shape[-1]))
+            small_pred = F.interpolate(mask_logits[:, None], size=size, mode="bilinear", align_corners=False)[:, 0]
+            small_target = F.interpolate(target[:, None], size=size, mode="nearest")[:, 0]
+            p, t = small_pred.flatten(1).detach(), small_target.flatten(1)
+            bce = (F.softplus(p).mean(-1)[:, None] - p @ t.T / p.shape[-1])
+            prob = p.sigmoid()
+            dice = 1 - (2 * prob @ t.T + 1) / (prob.sum(-1)[:, None] + t.sum(-1)[None] + 1)
+            rows, cols = linear_sum_assignment((bce + dice).float().cpu().numpy())
+            rows = torch.as_tensor(rows, device=logits.device)
+            cols = torch.as_tensor(cols, device=logits.device)
+            labels[rows] = 1
+            matched_pred, matched_target = mask_logits[rows], target[cols]
+            mask_losses.append(F.binary_cross_entropy_with_logits(matched_pred, matched_target))
+            probs = matched_pred.sigmoid().flatten(1)
+            t = matched_target.flatten(1)
+            dice_losses.append((1 - (2 * (probs * t).sum(1) + 1) / (probs.sum(1) + t.sum(1) + 1)).mean())
+        weights = labels + background_weight * (1 - labels)
+        objectness_losses.append((F.binary_cross_entropy_with_logits(logits, labels, reduction="none") * weights).sum() / weights.sum())
+    zero = pred_masks.sum() * 0
+    return {
+        "loss_objectness": torch.stack(objectness_losses).mean(),
+        "loss_mask": torch.stack(mask_losses).mean() if mask_losses else zero,
+        "loss_dice": torch.stack(dice_losses).mean() if dice_losses else zero,
+    }
