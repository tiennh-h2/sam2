+"""Train prompt-free SAM 2 image queries from single-class COCO polygons."""
+
+import argparse
+import json
+from collections import defaultdict
+from pathlib import Path
+
+import numpy as np
+import torch
+from PIL import Image, ImageDraw
+from torch.utils.data import DataLoader, Dataset
+
+from sam2.modeling.entity_query import EntityQueryModel, entity_query_loss
+
+
+MEAN = torch.tensor([0.485, 0.456, 0.406])[:, None, None]
+STD = torch.tensor([0.229, 0.224, 0.225])[:, None, None]
+
+
+def encode_image(image, image_size):
+    """Resize RGB image exactly as SAM 2's image predictor does."""
+    image = image.convert("RGB").resize((image_size, image_size), Image.Resampling.BILINEAR)
+    return (torch.from_numpy(np.asarray(image).copy()).permute(2, 0, 1).float() / 255 - MEAN) / STD
+
+
+class CocoInstanceDataset(Dataset):
+    def __init__(self, root, split, image_size=1024):
+        self.image_dir = Path(root) / split
+        path = self.image_dir / "_annotations.coco.json"
+        data = json.loads(path.read_text())
+        if len(data.get("categories", [])) != 1:
+            raise ValueError("Expected one COCO category")
+        self.images = sorted(data["images"], key=lambda item: item["id"])
+        self.annotations = defaultdict(list)
+        for annotation in data["annotations"]:
+            if annotation.get("iscrowd", 0):
+                continue
+            self.annotations[annotation["image_id"]].append(annotation)
+        self.image_size = image_size
+
+    def __len__(self):
+        return len(self.images)
+
+    def __getitem__(self, index):
+        info = self.images[index]
+        with Image.open(self.image_dir / info["file_name"]) as file:
+            image = file.convert("RGB")
+        masks = []
+        for annotation in self.annotations[info["id"]]:
+            polygons = annotation.get("segmentation", [])
+            if not isinstance(polygons, list):
+                raise ValueError("COCO RLE masks are unsupported; expected polygon lists")
+            mask = Image.new("L", image.size, 0)
+            draw = ImageDraw.Draw(mask)
+            for coordinates in polygons:
+                if len(coordinates) >= 6 and len(coordinates) % 2 == 0:
+                    points = np.asarray(coordinates, dtype=np.float64).reshape(-1, 2)
+                    area_twice = np.dot(points[:, 0], np.roll(points[:, 1], -1)) - np.dot(points[:, 1], np.roll(points[:, 0], -1))
+                    if abs(area_twice) > 1e-8:
+                        draw.polygon([tuple(point) for point in points], fill=1)
+            mask = mask.resize((self.image_size, self.image_size), Image.Resampling.NEAREST)
+            array = np.asarray(mask).copy()
+            if array.any():
+                masks.append(torch.from_numpy(array).float())
+        target = torch.stack(masks) if masks else torch.zeros(0, self.image_size, self.image_size)
+        return encode_image(image, self.image_size), target
+
+
+def collate_instances(batch):
+    images, masks = zip(*batch)
+    return torch.stack(images), list(masks)
+
+
+def train(args):
+    from sam2.build_sam import build_sam2
+
+    device = torch.device(args.device)
+    sam_model = build_sam2(args.model_cfg, args.sam_checkpoint, device=args.device, apply_postprocessing=False)
+    model = EntityQueryModel(sam_model, args.num_queries, freeze_backbone=not args.finetune_backbone).to(device)
+    dataset = CocoInstanceDataset(args.data_root, args.split, sam_model.image_size)
+    loader = DataLoader(dataset, batch_size=args.batch_size, shuffle=True,
+                        num_workers=args.workers, collate_fn=collate_instances)
+    if not len(loader):
+        raise ValueError("Training split has no images")
+    parameters = [p for p in model.parameters() if p.requires_grad]
+    optimizer = torch.optim.AdamW(parameters, lr=args.lr, weight_decay=0.01)
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    for epoch in range(args.epochs):
+        model.train()
+        running = 0.0
+        for images, targets in loader:
+            images = images.to(device)
+            optimizer.zero_grad(set_to_none=True)
+            losses = entity_query_loss(model(images), targets)
+            loss = sum(losses.values())
+            loss.backward()
+            optimizer.step()
+            running += loss.item()
+        print(f"epoch {epoch + 1}/{args.epochs}: loss={running / len(loader):.5f}", flush=True)
+        torch.save({
+            "query_head": model.query_head.state_dict(),
+            "sam_backbone": model.sam_model.state_dict() if args.finetune_backbone else None,
+            "num_queries": args.num_queries,
+            "image_size": sam_model.image_size,
+            "model_cfg": args.model_cfg,
+            "sam_checkpoint": str(args.sam_checkpoint),
+            "epoch": epoch + 1,
+        }, args.output)
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--data-root", type=Path, required=True)
+    parser.add_argument("--split", default="train")
+    parser.add_argument("--model-cfg", required=True)
+    parser.add_argument("--sam-checkpoint", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--num-queries", type=int, default=50)
+    parser.add_argument("--batch-size", type=int, default=1)
+    parser.add_argument("--epochs", type=int, default=20)
+    parser.add_argument("--lr", type=float, default=1e-4)
+    parser.add_argument("--workers", type=int, default=4)
+    parser.add_argument("--device", default="cuda")
+    parser.add_argument("--finetune-backbone", action="store_true")
+    return parser.parse_args()
+
+
+if __name__ == "__main__":
+    train(parse_args())
